rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Patitas Plus es un pago único por 30 días (no suscripción automática),
    // así que además de plan == 'plus' hay que verificar que no haya vencido.
    function isPlus() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.plan == 'plus'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.plusExpiresAt > request.time;
    }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // el plan se activa desde el backend (Cloud Functions) o a mano en la consola
    }

    match /mascotas/{docId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid;

      match /private/info {
        allow read: if request.auth != null && request.auth.uid == resource.data.ownerUid;
        allow create, update: if request.auth != null && request.auth.uid == request.resource.data.ownerUid;
        allow delete: if request.auth != null && request.auth.uid == resource.data.ownerUid;
      }

      match /private/contacto {
        allow read: if request.auth != null
                    && (request.auth.uid == resource.data.ownerUid || isPlus());
        allow create, update: if request.auth != null && request.auth.uid == request.resource.data.ownerUid;
        allow delete: if request.auth != null && request.auth.uid == resource.data.ownerUid;
      }
    }

    match /cruzas/{docId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid;

      match /private/info {
        allow read: if request.auth != null && request.auth.uid == resource.data.ownerUid;
        allow create, update: if request.auth != null && request.auth.uid == request.resource.data.ownerUid;
        allow delete: if request.auth != null && request.auth.uid == resource.data.ownerUid;
      }

      match /private/contacto {
        allow read: if request.auth != null
                    && (request.auth.uid == resource.data.ownerUid || isPlus());
        allow create, update: if request.auth != null && request.auth.uid == request.resource.data.ownerUid;
        allow delete: if request.auth != null && request.auth.uid == resource.data.ownerUid;
      }
    }

    match /patimatch_pets/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid;

      match /private/{privateId} {
        allow read: if request.auth != null && request.auth.uid == resource.data.ownerUid;
        allow create, update: if request.auth != null && request.auth.uid == request.resource.data.ownerUid;
        allow delete: if request.auth != null && request.auth.uid == resource.data.ownerUid;
      }
    }

    match /patimatch_swipes/{docId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                    && request.resource.data.fromUid == request.auth.uid;
    }

    match /patimatch_matches/{docId} {
      allow read: if request.auth != null
                    && request.auth.uid in resource.data.uids;
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.uids;
    }
  }
}
